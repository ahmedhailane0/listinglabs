[Unit]
Description=ListingLabs real-time screener alert daemon (fetch/screener_daemon.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/listinglabs/perps_correlation
# Secrets are sourced from the box-local env file (not in the repo). The
# leading "-" makes it optional so the daemon still runs (DRY_RUN-equivalent,
# no-op sends) if the file is ever missing.
EnvironmentFile=-/root/.config/listinglabs/telegram.env
# Start in DRY_RUN (writes fires_live.jsonl + heartbeat.json, computes real
# fires, but suppresses the Telegram send). Validate with
# tools/compare_daemon_fires.py against a few hours of the hourly ledger,
# THEN flip live: `systemctl edit screener-daemon` -> remove/blank this line
# (or set DRY_RUN=0) -> `systemctl daemon-reload && systemctl restart screener-daemon`.
Environment=DRY_RUN=1
ExecStart=/usr/bin/python3 /root/listinglabs/perps_correlation/fetch/screener_daemon.py
Restart=always
RestartSec=10
# Websocket reconnect logic has its own backoff; this is the outer safety net
# for a hard crash (e.g. an unhandled exception outside the reconnect loops).
StartLimitIntervalSec=600
StartLimitBurst=20

[Install]
WantedBy=multi-user.target
